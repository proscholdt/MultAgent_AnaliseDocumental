# Copie para .env e preencha. O .env nunca vai para o repositório.

# --- Obrigatórias ---
# Chave da OpenAI: embeddings (text-embedding-3-small) e as duas chamadas de LLM da indexação.
OPENAI_API_KEY=
# Segredo que assina os tokens JWT. Gere um: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# --- Parser: quem lê o PDF ---
# docling = roda na máquina, sem custo por página, minutos por documento em CPU (padrão).
# azure   = Azure AI Document Intelligence: o parse roda no serviço (tempo não medido aqui),
#           é pago por página, e o PDF é enviado ao recurso da Azure.
# Para trocar: mude PARSER, rode `docker compose up -d` e reenvie o PDF. Cada parser guarda o
# próprio cache, então voltar ao anterior não refaz o parse. `GET /health` mostra o parser ativo.
PARSER=docling
# Só para PARSER=azure. Endpoint e chave do recurso de Document Intelligence (portal da Azure,
# em "Keys and Endpoint"). Use o nível S0: o gratuito (F0) lê só as 2 primeiras páginas.
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=

# --- Opcionais (valores padrão entre parênteses) ---
# AZURE_DI_MODEL=prebuilt-layout
# AZURE_DI_PRICE_PER_1K_PAGES=10        # US$ por mil páginas, só para estimar o custo no job
# JWT_EXPIRES_MINUTES=60
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_LLM_MODEL=gpt-4o-mini          # modelo com visão e saída estruturada
# EMBEDDING_PROVIDER=openai             # "fake" roda o pipeline sem chamar a OpenAI (só para teste local)
# TABLE_MODE=accurate                   # "fast" troca qualidade de tabela por velocidade
# MAX_UPLOAD_MB=50
# MAX_ATTEMPTS=3

# --- Só para rodar a aplicação FORA do Docker (com a infra no compose) ---
# No docker compose estes valores já vêm definidos e apontam para os serviços internos.
# DATABASE_URL=postgresql+asyncpg://indexer:indexer@localhost:5432/indexer
# KAFKA_BOOTSTRAP_SERVERS=localhost:29092
# QDRANT_URL=http://localhost:6333
# STORAGE_DIR=storage
