# Copie para .env e preencha. O .env nunca vai para o repositório e guarda só chaves e segredos.
# Os ajustes (parser, chunks, preços, limites) ficam em config/ajustes.yaml, relido sem reiniciar.

# Chave da OpenAI: embeddings (text-embedding-3-small) e as duas chamadas de LLM da indexação.
OPENAI_API_KEY=
# Segredo que assina os tokens JWT. Gere um: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Só com `parser: azure` no config/ajustes.yaml. Endpoint e chave do recurso de Document
# Intelligence (portal da Azure, em "Keys and Endpoint"). Use o nível S0: o gratuito (F0) lê só
# as 2 primeiras páginas.
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=

# --- Só para rodar a aplicação FORA do Docker (com a infra no compose) ---
# No docker compose estes valores já vêm definidos e apontam para os serviços internos.
# DATABASE_URL=postgresql+asyncpg://indexer:indexer@localhost:5432/indexer
# KAFKA_BOOTSTRAP_SERVERS=localhost:29092
# QDRANT_URL=http://localhost:6333
# STORAGE_DIR=storage
# EMBEDDING_PROVIDER=fake   # roda o pipeline sem chamar a OpenAI (só para teste local)
