# Copie para .env e preencha. O .env não vai para o Git e guarda só chaves e segredos.
#   Cada agente (modelo, raciocínio, turnos): agentes/<nome>.md
#   O que vale para todos (preços, freios, tempos): config/ajustes.yaml
# Os dois são relidos sem build nem restart.

# Chave da OpenAI (a mesma do indexador serve).
OPENAI_API_KEY=
# Chave da Groq, só se algum agente usar um modelo "groq:...". O plano gratuito aceita no máximo
# 8 mil tokens por pedido: dá para perguntas, não para o relatório.
GROQ_API_KEY=

# Modo recomendado: `make chaves` gera uma chave Ed25519 por serviço, e os dois segredos abaixo
# deixam de ser usados (cada serviço só assina pelo próprio agente). Sem chaves, valem os segredos.
#
# O mesmo MCP_AGENT_SECRET do servidor MCP (mcp-server/.env).
MCP_AGENT_SECRET=
# Segredo do A2A entre o orquestrador e os especialistas (32+ caracteres).
A2A_SECRET=

# Rodando fora do Docker, os endereços padrão são os do localhost; para mudar:
# MCP_URL=http://localhost:8100/mcp
# INDEXER_URL=http://localhost:8000
# ESPECIALISTAS_URL=http://localhost:8201   # um serviço só, sem ESPECIALISTA, atende todos
# No Docker, cada especialista tem o próprio serviço: os endereços estão no docker-compose.yml.

# Postgres para várias réplicas (checkpoint, execuções, memória e tarefas A2A). No compose, use
# AGENTS_DATABASE_URL. Vazio: arquivos e SQLite na pasta de dados.
# AGENTS_DATABASE_URL=postgresql://indexer:indexer@postgres:5432/agentes
