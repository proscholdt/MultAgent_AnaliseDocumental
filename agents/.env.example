# Copie para .env e preencha. O .env não vai para o Git.

# Chave da OpenAI (a mesma do indexador serve).
OPENAI_API_KEY=

# Apelido -> modelo. O arquivo de cada agente usa o apelido ("modelo: padrao").
MODELOS={"padrao": "gpt-5.4-mini", "forte": "gpt-5.4"}

# US$ por milhão de tokens de cada modelo usado, para o cálculo de custo. Os valores abaixo são
# os da página do modelo na OpenAI em 13/11/2026; confira a tabela atual antes de confiar no
# custo. Modelo sem preço aqui aparece com os tokens e sem custo.
PRECOS={"gpt-5.4-mini": {"entrada": 0.75, "entrada_cache": 0.075, "saida": 4.50}, "gpt-5.4": {"entrada": 2.50, "entrada_cache": 0.25, "saida": 15.00}}

# Servidor MCP. O segredo tem de ser IGUAL ao MCP_AGENT_SECRET do mcp-server/.env.
MCP_URL=http://localhost:8100/mcp
MCP_AGENT_SECRET=

# Segredo do A2A, entre o orquestrador e os especialistas (32 caracteres ou mais).
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
A2A_SECRET=

# Onde os especialistas atendem (o orquestrador chama este endereço) e onde está o indexador.
ESPECIALISTAS_URL=http://localhost:8201
INDEXER_URL=http://localhost:8000

# Freios de uma execução inteira.
# EXECUCAO_MAX_SEGUNDOS=2400
# EXECUCAO_MAX_TOKENS=6000000
# RODADAS_PENDENCIAS=2

# Resumo do raciocínio que a OpenAI devolve ("detailed", "auto" ou vazio para não pedir). Entra no
# trace local e nas mensagens guardadas de cada agente; nada disso sai da máquina.
# RESUMO_RACIOCINIO=detailed

# Memória de cada especialista na conversa: teto, em tokens estimados, do histórico reenviado.
# MEMORIA_MAX_TOKENS=40000
