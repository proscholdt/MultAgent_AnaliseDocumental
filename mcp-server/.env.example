# Copie para .env e preencha. O .env nunca vai para o Git.

# Segredo que assina os tokens dos agentes. Tem de ser o MESMO valor configurado no sistema
# dos agentes (agents/.env), que é quem emite os tokens.
# Gere um: python -c "import secrets; print(secrets.token_urlsafe(48))"
MCP_AGENT_SECRET=

# Chave das rotas de administração (/governanca e /auditoria), enviada no cabeçalho X-Admin-Key.
ADMIN_KEY=

# Onde está o indexador (sistema 1). Dentro do Docker, o padrão do compose já aponta para a
# máquina hospedeira.
# INDEXER_URL=http://localhost:8000

# --- Opcionais (valores padrão entre parênteses) ---
# POLICY_PATH=policy.yaml                 # quem pode ver e chamar o quê
# DATABASE_URL=sqlite+aiosqlite:///./data/mcp.db
# MCP_AUDIENCE=mcp-server                 # destinatário esperado no token do agente
# USER_CACHE_SECONDS=300                  # por quanto tempo vale a consulta "quem é este usuário"
# SEARCH_TEXT_CHARS=1200                  # quanto do texto de cada trecho a busca devolve
