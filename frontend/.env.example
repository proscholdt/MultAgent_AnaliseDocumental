# Frontend. Nenhuma chave aqui: o token do usuário vem do login, em cookie httpOnly.

# Fora do Docker (npm run dev / npm start): onde estão o indexador e o orquestrador.
# Se outra aplicação ocupa 127.0.0.1:8000 na sua máquina, use o endereço IPv6: http://[::1]:8000
INDEXER_URL=http://localhost:8000
AGENTS_URL=http://localhost:8200

# No Docker, o compose já aponta para os serviços pela rede do indexador. Só mude se for outro lugar.
# INDEXER_URL_DOCKER=http://api:8000
# AGENTS_URL_DOCKER=http://orquestrador:8200
# INDEXER_NETWORK=indexer_default

# O endereço que o navegador usa para abrir a tela (o SvelteKit confere a origem do login com ele).
ORIGIN=http://localhost:3000

# true quando a tela for servida por HTTPS (o cookie da sessão só vai por HTTPS).
COOKIE_SECURE=false

# Tamanho máximo de um envio pelo proxy (o indexador aceita PDFs de até 50 MB).
BODY_SIZE_LIMIT=60M
