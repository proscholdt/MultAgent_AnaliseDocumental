    {
      "id": 11,
      "type": "bargauge",
      "title": "Operações mais lentas (p95)",
      "description": "Qualquer etapa: requisição, execução, chamada ao modelo, tool, leitura de PDF. Aproximado: o Tempo mede a duração em faixas que dobram de tamanho.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ name !~ \"a2a[.].*|.* http (send|receive)\" && (span.conversa.id = \"$conversa\" || \"$conversa\" = \".*\") } | quantile_over_time(duration, .95) by (name)",
          "metricsQueryType": "range",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "color": {
            "mode": "continuous-GrYlRd"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "values": true,
          "calcs": [],
          "fields": "/^Max$/"
        }
      },
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": ".*(?:resource\\.service\\.name|name)=\"([^\"]*)\".*",
            "renamePattern": "$1"
          }
        },
        {
          "id": "reduce",
          "options": {
            "reducers": [
              "max"
            ],
            "mode": "seriesToRows"
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Max",
                "desc": true
              }
            ]
          }
        },
        {
          "id": "limit",
          "options": {
            "limitField": 8
          }
        }
      ]
    },
