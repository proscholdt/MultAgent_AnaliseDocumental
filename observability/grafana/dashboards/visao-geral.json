          "queryType": "traceql",
          "query": "{ name =~ \"execucao.*\" && (span.conversa.id = \"$conversa\" || \"$conversa\" = \".*\") }",
          "limit": 30,
          "tableType": "traces"
        }
      ],
      "fieldConfig": {
        "defaults": {},
