{
  "uid": "visao-geral",
  "title": "Visão geral",
  "description": "Os quatro serviços: tráfego, erros, latência, mapa e logs. Escolha uma conversa no alto para ver só ela.",
  "tags": [
    "demonstracoes"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "conversa",
        "label": "Conversa",
        "type": "query",
        "datasource": {
          "type": "tempo",
          "uid": "tempo"
        },
        "query": {
          "type": 1,
          "label": "conversa.rotulo",
          "refId": "TempoDatasourceVariableQueryEditor-VariableQuery"
        },
        "definition": "conversa.rotulo",
        "regex": "/^(?<text>.*\\((?<value>conv-[0-9a-f]+)\\))$/",
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "sort": 0,
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "projeto",
        "label": "Serviço (logs)",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "label": "projeto",
          "type": 1,
          "stream": ""
        },
        "definition": "label_values(projeto)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Painéis",
      "type": "dashboards",
      "tags": [
        "demonstracoes"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Requisições por segundo",
      "description": "Média no período das requisições recebidas pelos serviços.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ kind = server && (span.conversa.id = \"$conversa\" || \"$conversa\" = \".*\") } | rate()",
          "metricsQueryType": "range",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "noValue": "0",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "mean"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Respostas com erro",
      "description": "",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ kind = server && (span.conversa.id = \"$conversa\" || \"$conversa\" = \".*\") && status = error } | count_over_time()",
          "metricsQueryType": "range",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          },
          "noValue": "0",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Latência p95",
      "description": "O maior p95 das requisições recebidas, entre as janelas do período. Calculado pelo Tempo a partir dos traces, em faixas que dobram de tamanho: o valor é aproximado (8,59 s, 17,18 s...).",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ kind = server && (span.conversa.id = \"$conversa\" || \"$conversa\" = \".*\") } | quantile_over_time(duration, .95)",
          "metricsQueryType": "range",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          },
          "noValue": "0",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "max"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Execuções dos agentes",
      "description": "Execuções terminadas no período (relatórios, perguntas, turnos de conversa).",
      "datasource": {
        "type": "tempo",
