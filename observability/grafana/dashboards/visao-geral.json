    },
    {
      "id": 5,
      "type": "stat",
      "title": "Custo dos agentes",
      "description": "Custo de modelo das execuções do período, gravado no span de cada execução.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ name =~ \"execucao.*\" && (span.conversa.id = \"$conversa\" || \"$conversa\" = \".*\") } | sum_over_time(span.execucao.custo_usd)",
          "metricsQueryType": "range",
          "limit": 20,
          "tableType": "traces"
