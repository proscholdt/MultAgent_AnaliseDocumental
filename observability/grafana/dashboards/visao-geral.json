    {
      "id": 14,
      "type": "logs",
      "title": "Logs",
      "description": "Sem as linhas de acesso a /auth/me (cada requisição confere o login no indexador) e /health. Com uma conversa escolhida, só as linhas com conversa=<id>, de todos os serviços.",
      "datasource": {
