{
  "uid": "indexador",
  "title": "Indexador",
  "description": "Ingestão: etapas, filas, páginas, chunks, custo e a API. Escolha uma conversa no alto para ver o que ela pediu ao indexador.",
  "tags": [
    "documentos",
    "indexador"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "conversa",
        "label": "Conversa",
        "type": "query",
        "datasource": {
          "type": "tempo",
          "uid": "tempo"
        },
        "query": {
          "type": 1,
          "label": "conversa.rotulo",
          "refId": "TempoDatasourceVariableQueryEditor-VariableQuery"
        },
        "definition": "conversa.rotulo",
        "regex": "/^(?<text>.*\\((?<value>conv-[0-9a-f]+)\\))$/",
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "sort": 0,
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Painéis",
      "type": "dashboards",
      "tags": [
        "documentos"
      ],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Limpar filtros",
      "type": "link",
      "icon": "bolt",
      "tooltip": "Todas as listas em All",
      "url": "/d/indexador?var-conversa=$__all&var-projeto=$__all",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "asDropdown": false,
      "tags": []
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Páginas",
      "description": "O upload e a leitura dos PDFs não são de uma conversa: com uma conversa escolhida, aqui fica zero. O que a conversa usou do indexador está nas requisições da API.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ name =~ \"parse .*\" && (span.conversa.id = \"$conversa\" || \"$conversa\" = \".*\") } | sum_over_time(span.indexador.paginas)",
          "metricsQueryType": "range",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "noValue": "0",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "id": 2,
