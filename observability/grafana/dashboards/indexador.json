      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ span.messaging.destination =~ \"indexer[.](parse|index)\" && (span.conversa.id = \"$conversa\" || \"$conversa\" = \".*\") && status = error } | count_over_time()",
          "metricsQueryType": "range",
          "limit": 20,
